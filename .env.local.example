# 把这个文件复制成 .env.local，然后把下面三个值替换成真实的
# 注意：.env.local 已经在 .gitignore 里，不会被推到 GitHub

# Kimi (Moonshot) API Key（你已经有了）
# 在 https://platform.moonshot.cn/console/api-keys 看
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Supabase 项目配置
# 注册后在 https://supabase.com/dashboard/project/<你的项目>/settings/api 看
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJI...（很长的一串）
