# 把这个文件复制成 .env.local，然后把下面的值替换成真实的
# .env.local 已在 .gitignore 中，不会被推到 GitHub

# Kimi (Moonshot) API Key
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbG...（很长一串）

# Web Push VAPID（用 node generate-vapid.mjs 之类的脚本生成）
VAPID_PUBLIC_KEY=B...（87 个字符的 base64url）
VAPID_PRIVATE_KEY=...（43 个字符的 base64url）
VAPID_SUBJECT=mailto:你的邮箱@example.com

# Cron 触发器密钥（外部 cron 服务调用 /api/cron-check 时带这个）
CRON_SECRET=随机一长串
